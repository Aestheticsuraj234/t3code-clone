# Pooled Neon URL — runtime (Neon serverless driver + PrismaNeon adapter in the app).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct Neon host — Prisma CLI (migrate / db pull); do not remove if you use the pooler URL above for DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require"

# Better Auth — use your deployed origin in production
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-output-of-openssl-rand-base64-32"

# Origin exposed to the browser — must match BETTER_AUTH_URL (better-auth reads NEXT_PUBLIC_AUTH_URL too).
NEXT_PUBLIC_AUTH_URL="http://localhost:3000"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# E2B sandboxes — https://e2b.dev/docs (team dashboard → API key)
E2B_API_KEY=""
# Optional: template id or name (default: base)
E2B_TEMPLATE="base"
# Optional: sandbox lifetime in ms (default: 1800000 = 30 minutes)
# E2B_SANDBOX_TIMEOUT_MS=1800000
